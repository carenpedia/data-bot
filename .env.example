# ============================================
# DATA BOT — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env
# ============================================

# Token dari BotFather Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID admin (untuk command admin)
# Cara cek: kirim pesan ke @userinfobot di Telegram
ADMIN_ID=your_telegram_id_here

# ID Folder Google Drive (Opsional tapi sangat disarankan)
# Gunakan ini agar penyimpanan file Google Sheet dibebankan ke akun Google Anda,
# bukan ke kuota Service Account (yang dibatasi 0 byte oleh Google).
# Cara dapatkan ID Folder:
# 1. Buat folder di Google Drive Anda (misal: "Data Bot").
# 2. Bagikan folder tersebut ke email Service Account Anda sebagai "Editor".
# 3. Salin ID folder dari URL browser Anda (bagian setelah /folders/...)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
